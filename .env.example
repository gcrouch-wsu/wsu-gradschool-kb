KB_ADMIN_EMAIL=admin@example.edu
KB_ADMIN_PASSWORD=ChangeMe123!
# Required in production: the app refuses to sign cookies rather than derive a key from the
# bootstrap credentials. Outside production a dev secret is derived when this is unset.
# Changing it invalidates every existing session cookie.
KB_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Alias names also supported:
# BOOTSTRAP_OWNER_EMAIL=admin@example.edu
# BOOTSTRAP_OWNER_PASSWORD=ChangeMe123!
# BOOTSTRAP_OWNER_SESSION_SECRET=replace-with-a-long-random-secret

# Optional but recommended in production: comma-separated public hostname(s) this app is
# served on. When set, the admin same-origin check trusts only these hosts, so a spoofed
# x-forwarded-host cannot define the origin a mutation is compared against. When unset, the
# check falls back to VERCEL_PROJECT_PRODUCTION_URL and then to the request's own headers.
# APP_PUBLIC_HOST=kb.wsu.edu

# Optional: Neon Postgres connection string for durable KB content.
# When unset, the app serves the in-memory seed dataset (fine for local dev,
# not durable). When set, the schema is auto-created and seeded on first run.
#
# Which Neon project belongs where (both are Vercel-managed integrations on the
# wsu-gradschool-kb project). `npm run test:db` writes and deletes rows against
# whatever this points at, so the distinction matters:
#   local / Development -> kb-local-test        (Neon ID solitary-smoke-86654244)
#   Production          -> neon-crimson-battery (Neon ID withered-dust-89775495)
# Never point a local DATABASE_URL at the production project. Note that
# kb-local-test holds a copy of real content, so "the data looks real" is not a
# way to tell the two apart — check the endpoint host.
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Optional: Vercel Blob token for importing images from .docx uploads.
# Set automatically on Vercel when a Blob store is connected; pull locally with
# `vercel env pull`. When unset, DOCX import skips images (text still imports).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Required for the scheduled audit-log retention route in production.
# CRON_SECRET="b506be1537e2b763b479135e6ca47040a0b53f11860b777b6640283d7fa8273b"

# Optional: HTTP email provider for weekly review-date digest emails.
# When EMAIL_PROVIDER_URL is unset, the digest logs structured JSON and does
# not fail the cron run.
# EMAIL_PROVIDER_URL=https://email-provider.example/send
# EMAIL_PROVIDER_TOKEN=provider-token
# EMAIL_FROM="WSU Graduate School KB <no-reply@example.edu>"

# Optional: comma-separated API keys for the public KaaS API
# (`GET` plus limited `PATCH` summary/blocks writes for published public pages at
# `/api/v1/kb/{slug}/pages/{path...}`). When unset, the API rejects all callers.
# KAAS_API_KEYS=replace-with-long-random-key

# Optional: Sentry DSN for third-party error grouping. When unset, logError only
# writes structured JSON to the console (Vercel log drains).
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0

# Optional: Vercel AI Gateway for page-editor "Draft with AI" / "Review with AI".
# When unset, those APIs return 501 (not configured). Successful calls record
# privacy-light token totals on /admin/usage when DATABASE_URL is set.
# AI_PROVIDER_ENDPOINT=https://ai-gateway.vercel.sh/v1/chat/completions
# AI_API_KEY=vck_xxxxxxxx
# AI_MODEL=inclusionai/ling-3.0-flash-free
